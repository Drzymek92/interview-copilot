# interview_copilot — environment. Copy to config/.env and fill in. NEVER commit config/.env.
# Everything here is a SECRET or a machine-specific endpoint; non-secret tunables live in
# config/settings.py (CFG). Precedence: CLI > env > config default.

# --- Reasoning backend (D14 / SI1) -------------------------------------------
# "local" (default) keeps the transcript and the context bundle on this machine.
# "cloud" is an EXPLICIT egress of interview transcript + resume + JD to a third party.
# It is opt-in, it is announced on every call, and it refuses to run unless all three
# CLOUD_* vars below are set. Do not set this to "cloud" casually.
REASONING_BACKEND="local"

# --- local: Ollama — free, on-GPU, no egress --------------------------------
OLLAMA_BASE_URL="http://localhost:11434/v1"
# Use a CUSTOM model built with `./ollama/build_models.sh` (num_ctx baked to 16384). Do NOT point
# this at a stock tag like `llama3.1:8b` — its 4096 window silently truncates the session bundle.
#   interview-copilot:8b  = fast default (~7 GB VRAM)
#   interview-copilot:14b = higher quality (~11.5 GB VRAM)
OLLAMA_MODEL="interview-copilot:8b"
OLLAMA_API_KEY="ollama"   # Ollama ignores the value; the OpenAI client needs it non-empty

# --- cloud: BYOK, any OpenAI-compatible endpoint -----------------------------
# Deliberately no defaults: a baked-in provider/model is one env var away from a silent
# egress. D14 names Claude/GPT; both are reachable through their OpenAI-compatible
# endpoints, so no vendor SDK is needed.
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=
