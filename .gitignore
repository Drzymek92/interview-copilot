# environment
.venv/
venv/
.env
config/.env

# data — never commit real interview inputs or generated outputs (privacy invariant, SI1)
scripts/inputs/
scripts/outputs/
logs/

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# credentials (broad guard — keep it, then re-include the specific data files that MUST ship)
*.json
*.p12
# ...but these committed data files are not credentials:
!examples/**/*.json
!tests/fixtures/*.json

# editor / OS
.vscode/
.idea/
.DS_Store

# desktop launcher is machine-specific — ship the .template, generate the real .desktop locally
*.desktop

# D36: UI-saved settings are per-user
config/user_settings.json

# D37: the built-in default bundle is a tracked template (not user data)
!config/bundles/
!config/bundles/*/
!config/bundles/*/bundle.json
